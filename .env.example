# AbiLearn — Firebase Configuration
# ─────────────────────────────────────────────────────────────────
# These values come from your Firebase Console:
#   https://console.firebase.google.com → Project Settings → Your apps → Web app
#
# The Firebase web API key is NOT secret — it identifies your project.
# Security is enforced by Firestore Security Rules (firestore.rules).
#
# Add these values directly to js/firebase-config.js.
# Do NOT expose private service account keys in this file.
# ─────────────────────────────────────────────────────────────────

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
