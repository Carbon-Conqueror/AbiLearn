# Owlix AI — Environment Variables
# ─────────────────────────────────────────────────────────────────
# For Cloudflare Pages: add these in
#   Pages Dashboard → Settings → Environment variables
#   (use "Secrets" for AI_API_KEY so it is encrypted at rest)
#
# For local development with Wrangler CLI:
#   Copy this file to .env (never commit .env to git)
# ─────────────────────────────────────────────────────────────────

# REQUIRED — your LLM provider API key
AI_API_KEY=

# PROVIDER — "anthropic" (default) or "openai"
# Use "openai" for any OpenAI-compatible endpoint (Groq, Together, etc.)
AI_PROVIDER=anthropic

# MODEL — model identifier for your provider
# Anthropic examples:  claude-haiku-4-5-20251001  claude-sonnet-5
# OpenAI examples:     gpt-4o-mini  gpt-4o
# Groq examples:       llama-3.3-70b-versatile  mixtral-8x7b-32768
AI_MODEL=claude-haiku-4-5-20251001

# BASE_URL — only needed for non-Anthropic OpenAI-compatible providers
# Groq:    https://api.groq.com/openai
# OpenAI:  https://api.openai.com
# Together:https://api.together.xyz
# AI_BASE_URL=
